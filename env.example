# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexgenpro

# JWT
JWT_SECRET=your_jwt_secret_here

# HubSpot OAuth
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=https://thebodyguard.co/auth/hubspot/callback

# Salesforce OAuth
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_REDIRECT_URI=https://thebodyguard.co/auth/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Alerts
ALERT_EMAIL_FROM=alerts@nexgenpro.org
ALERT_EMAIL_TO=hello@nexgenpro.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_app_password

# Frontend
FRONTEND_URL=https://thebodyguard.co
